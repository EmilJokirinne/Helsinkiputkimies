# Kopioi tiedosto nimelle .env.local (paikallisesti) tai lisää muuttujat
# Vercelin projektiasetuksiin (Settings → Environment Variables).
# Älä tallenna oikeita salaisuuksia versionhallintaan.

# --- Sivusto ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://helsinkiputkimies.fi

# --- Ylläpitäjä (PAKOLLINEN ennen julkaisua) -------------------------------
# Näytetään tietosuojaselosteessa ja alatunnisteessa. Älä keksi tietoja.
SITE_OPERATOR_NAME=
SITE_OPERATOR_BUSINESS_ID=
SITE_OPERATOR_EMAIL=
SITE_OPERATOR_ADDRESS=

# --- Tarjouspyyntöjen toimitus (valinnainen) --------------------------------
# Ilman näitä lomake toimii silti: käyttäjä saa valmiin tarjouspyynnön, jonka
# hän lähettää yritykselle itse. Mitään ei tallenneta.
# Kehitystilassa (npm run dev) pyynnöt kirjoitetaan tiedostoon .data/leads.jsonl.

# Sähköposti Resendin kautta (https://resend.com). Kaikki kolme tarvitaan.
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Lähettäjän osoitteen domain pitää olla vahvistettu Resendissä.
LEAD_FROM_EMAIL=

# Webhook CRM:ään, Makeen, Zapieriin tai omaan rajapintaan (JSON POST).
LEAD_WEBHOOK_URL=
# Lähetetään otsakkeessa Authorization: Bearer <arvo>
LEAD_WEBHOOK_SECRET=
